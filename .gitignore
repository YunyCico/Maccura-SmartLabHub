.venv/
__pycache__/
*.py[cod]
.env
.pytest_cache/
node_modules/
# 构建产物：**要精确到目录**。写裸 `dist/` 会匹配任意层级，
# 导致 modules/service_demand/frontend/dist 里的新文件加不进 git
# （老文件能删、新文件被挡，提交上去 index.html 会引用不存在的 assets）。
/dist/
home/dist/
platform/tools/dist/
.DS_Store
uploads/
exports/
data/
modules/*/data/
*.db
.pytest_cache/
.smartlabhub-review/

# 迁移/恢复过程的中间产物：体积大且可重新生成，不入库
backup/_migration/

# 运行期产物
logs/
shots/
*.log

# 排查过程的临时产物：不参与版本管理
#  - /db        某次调试把表结构 dump 存成了根目录的 db 文件（不是数据库）
#  - _*.png     验证脚本留下的截图/测试图
#  - _backup/   脚本改写前的 xlsx 备份
/db
platform/tools/_backup/
platform/tools/_*.png

# 备份产物（含账号库和数据，绝不能进库）
/backups/

# 账号迁移的导出文件：**含 scrypt 密码摘要，等同于密码明文**
# 账号库(*.db) 已经被挡了，但这个 JSON 不会被上面的规则覆盖，必须单独挡。
accounts_export.json
platform/backend/accounts_export.json
platform/tools/_accounts_export*.json
*.accounts.json
