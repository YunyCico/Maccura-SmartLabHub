APP_NAME=Department Platform API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://platform_user:platform_password@localhost:5432/department_platform
CORS_ORIGINS=http://localhost:5173

# ============ 钉钉 ============
# 凭据仅存本机 .env，勿提交真实值；留空则首页展示示例数据。
# 取值位置：钉钉开放平台 → 应用开发 → 你的企业内部应用 → 凭证与基础信息
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 拉取哪些类型：todo(待办) / notify(工作通知) / ding(DING) / calendar(日程)，逗号分隔
DINGTALK_MESSAGE_KINDS=todo,notify,ding,calendar
# 可选：默认使用的钉钉 userid。留空则由前端免登 authCode 换取
DINGTALK_USER_ID=

# ============ 公司 OA（泛微 e-cology · oa.maccura.com）============
# 实测结论：该站所有 /api/* 未登录时都返回同一个鉴权错误，无法靠状态码探测真实端点，
# 因此下面的路径必须由 OA 管理员或浏览器 F12 抓包确认后填写，没有猜测默认值。
OA_BASE_URL=https://oa.maccura.com
# password=账号密码登录 | token=直接带固定令牌/Cookie
OA_AUTH_MODE=password
OA_USERNAME=
OA_PASSWORD=
OA_TOKEN=
# token 模式下自定义请求头名，如 X-Token；留空则当 Cookie 用
OA_AUTH_HEADER=
# 登录接口路径，如 login/CheckLogin.jsp
OA_LOGIN_PATH=
# 待办列表接口路径（必填），如 api/workflow/paService.do
OA_TODO_PATH=
# 追加查询参数，形如 userId=xxx&pageSize=20
OA_TODO_QUERY_PARAMS=
# 列表在响应 JSON 里的位置，多层用点号，如 result.todos
OA_ROWS_PATH=
# 字段映射（必填，至少要有 title）。示例：
# OA_FIELD_MAP={"title":"subject","due":"finishTime","creator":"creator","id":"workflowid","url":"link","priority":"urgency"}
OA_FIELD_MAP=
OA_DEFAULT_TITLE=OA 待办
OA_TIMEOUT_SECONDS=10
OA_MAX_ITEMS=30

# ============ Salesforce（当前暂缓，保留来源位）============
# 启用时二选一：
# 1) 真 Salesforce：填 instance_url + client_id/secret（或直接 access_token）
# 2) 实为自研 CRM 但叫 Salesforce：填 instance_url + token，路径复用 OA 那套写法
# Salesforce（真实例 maccuracn.my.sfcrmproducts.cn，Lightning 界面在 maccuracn.lightning.sfcrmapps.cn）
SALESFORCE_AUTH_MODE=totp
SALESFORCE_INSTANCE_URL=https://maccuracn.my.sfcrmproducts.cn
SALESFORCE_API_VERSION=v62.0
SALESFORCE_ORG_ID=00DC8000009rygr
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
# Authenticator App 设置页的 base32「手动输入密钥」，不是那串 6 位验证码
SALESFORCE_TOTP_SECRET=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_TOKEN=
